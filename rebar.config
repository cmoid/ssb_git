{erl_opts, [debug_info]}.

%% The node's own `ssb` app, for its behaviours (ssb_view, ssb_plugin), its
%% store and registries, and ssb.hrl.  It is compiled here only so that this
%% app compiles against it; at runtime ssb_git uses the beams of the node it
%% is loaded into, never these.
%%
%% For local work against an erlbutt checkout, `make checkout` symlinks
%% _checkouts/ssb at its apps/ssb, which rebar3 then uses in place of this.
%%
%% apps/ssb has no rebar.config of its own, so its own dependencies (ranch,
%% enacl, esqlite) are not fetched.  Nothing here needs them to compile; a
%% test that needs a running node is a CT suite against a real one.
{deps, [{ssb, {git_subdir, "https://github.com/cmoid/erlbutt.git",
               {branch, "main"}, "apps/ssb"}}]}.

{profiles, [{test, [{erl_opts, [nowarn_export_all]}]}]}.
